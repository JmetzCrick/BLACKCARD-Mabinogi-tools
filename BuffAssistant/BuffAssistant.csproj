<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\Images\AppIcon.ico</ApplicationIcon>
    <AssemblyName>블랙카드 도우미</AssemblyName>
    <Product>블랙카드 도우미</Product>
    <AssemblyTitle>블랙카드 도우미</AssemblyTitle>
    <Version>0.1.2-beta.1</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>BETA 0.1.2</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="auction-shared.enc" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="github-update.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="auction-key.bin" CopyToOutputDirectory="PreserveNewest" Condition="'$(PublicRelease)' != 'true' and Exists('auction-key.bin')" />
    <Content Include="Assets\auction-names.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 공개 배포에서는 OCR을 사용하지 않습니다. 기존 의존성은 주석으로 보존합니다.
    <PackageReference Include="Tesseract" Version="5.2.0" /> -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Music\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Alerts\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\FastPing\*.bat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Updates\*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Images\LoadingCharacter.png" />
    <Resource Include="Assets\Images\AppIcon.ico" />
    <Resource Include="Assets\Fonts\Mabinogi_Classic_TTF.ttf" />
    <!-- OCR 데이터는 배포 대상에서 제외합니다.
    <Content Include="tessdata\\**\\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content> -->
  </ItemGroup>
</Project>

