<Window x:Class="BuffAssistant.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="블랙카드 도우미 시작" Width="360" Height="450" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="#EDF0F8" ShowInTaskbar="False" AllowsTransparency="True" Opacity="0">
 <Grid>
  <Border Background="{StaticResource NavyGradient}" BorderThickness="0" CornerRadius="16"/>
  <Canvas x:Name="StarlightCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
  <Border Background="Transparent" BorderThickness="0" Padding="15">
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,18">
     <Ellipse><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F3F4F8" Offset="0.5"/><GradientStop Color="#CED4DE" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
     <Image x:Name="CharacterImage" Source="/블랙카드 도우미;component/Assets/Images/LoadingCharacter.png" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="150,150" RadiusX="148" RadiusY="148"/></Image.Clip></Image>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center">
     <TextBlock Text="블랙카드 도우미" FontFamily="{StaticResource GameFont}" FontSize="25" FontWeight="Normal" Foreground="#F1F4FF" HorizontalAlignment="Center"/>
     <TextBlock Text="블랙카드 - MD리하" FontFamily="{StaticResource GameFont}" FontSize="11" FontWeight="Normal" Foreground="#BFCBE5" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
     <Border Height="3" Width="36" Background="#A8B9E4" Margin="0,14,0,0"/>
    </StackPanel>
   </Grid>
 </Border>
 </Grid>
</Window>




