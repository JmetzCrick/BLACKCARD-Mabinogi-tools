<Window x:Class="BuffAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Icon="/블랙카드 도우미;component/Assets/Images/AppIcon.ico" Title="블랙카드 도우미" Width="440" Height="680" MinWidth="420" MinHeight="660" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="106" ResizeBorderThickness="5" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style></Window.Resources>
 <Border BorderBrush="{StaticResource OutlineGradient}" BorderThickness="0" CornerRadius="16"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="ClockFrame" Grid.Row="0" Background="{StaticResource FrameGradient}" BorderBrush="#B9C9FF" BorderThickness="1" CornerRadius="14" Margin="7,4,7,9" Padding="16,6"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◷" Foreground="#B9C9FF" FontSize="22" Margin="0,0,8,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="에린 시간" Foreground="#B9C9FF" FontSize="11"/><TextBlock x:Name="ErinWeekdayText" FontSize="10" Foreground="#B9C9FF" Margin="0,3,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ErinPeriodText" Text="AM" FontSize="11" Foreground="#B9C9FF" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="ErinDigitalText" Text="12 : 00" FontSize="27" Foreground="#EDF0F8"/></StackPanel></Grid></Border>
  <Border x:Name="TitleBar" Grid.Row="1" Background="{StaticResource NavyGradient}" CornerRadius="16" Padding="12,0,6,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="블랙카드 도우미" Foreground="#B9C9FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="HeaderVersionText" Text="BETA 0.1" Foreground="{StaticResource Muted}" FontSize="9" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="MusicTabButton" Content="&#xE189;" Style="{StaticResource Icon}" ToolTip="음악 선택 / 볼륨" Click="MusicTab_Click"/>
    <Button x:Name="RepeatButton" Content="&#xE8EE;" Style="{StaticResource Icon}" ToolTip="반복 재생" Click="Repeat_Click"/>
    <Button x:Name="PlayPauseButton" Content="&#xE768;" Style="{StaticResource Icon}" ToolTip="재생 / 일시정지" Click="PlayPause_Click"/>
    <Button x:Name="MuteButton" Content="&#xE74F;" Style="{StaticResource Icon}" ToolTip="음소거" Click="Mute_Click"/>
    <Border Width="1" Height="14" Background="#343C50" Margin="4,0"/>
    <Button x:Name="CollapseButton" Content="&#xE921;" Style="{StaticResource Icon}" ToolTip="기능창 접기" Click="Minimize_Click"/>
    <Button Content="&#xE8BB;" Style="{StaticResource Icon}" ToolTip="닫기" Click="Close_Click"/>
   </StackPanel>
  </Grid></Border>
  <Grid x:Name="FeaturePanel" Grid.Row="2" Margin="0,10,0,0">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,6"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="FastPingTabButton" Content="패스트핑" Click="FastPingTab_Click" FontSize="11" Padding="6,5" Margin="0,0,4,0"/>
    <Button x:Name="AuctionTabButton" Grid.Column="1" Content="경매장" Click="AuctionTab_Click" FontSize="11" Padding="6,5" Margin="4,0,0,0"/>
    <Button x:Name="BeadTabButton" Grid.Column="2" Content="구구" Click="BeadTab_Click" FontSize="11" Padding="6,5" Margin="4,0,0,0"/>
    <Button x:Name="FeeTabButton" Grid.Column="3" Content="수수료" Click="FeeTab_Click" FontSize="11" Padding="6,5" Margin="4,0,0,0"/>
    <Button x:Name="GatheringTabButton" Grid.Row="1" Content="채집 시간" Click="GatheringTab_Click" FontSize="11" Padding="6,5" Margin="0,4,4,0"/>
    <Button x:Name="BuffTabButton" Grid.Row="1" Grid.Column="1" Click="BuffTab_Click" FontSize="11" Padding="6,5" Margin="4,4,0,0" ToolTip="넥슨정책상 해당 기능이 지원되지 않습니다."><Grid Width="76" Height="20"><TextBlock Text="음악버프" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="BuffWarningIcon" Text="❗" FontFamily="Segoe UI Emoji" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,0,0"/></Grid></Button>
    <Button x:Name="UpdateTabButton" Grid.Row="1" Grid.Column="2" Content="업데이트" Click="UpdateTab_Click" FontSize="11" Padding="6,5" Margin="4,4,0,0"/>
    <Button x:Name="SettingsTabButton" Grid.Row="1" Grid.Column="3" Content="설정" Click="SettingsTab_Click" FontSize="11" Padding="6,5" Margin="4,4,0,0"/>
   </Grid>
   <Border x:Name="FastPingPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed">
    <StackPanel><TextBlock Text="패스트핑" FontSize="17" Margin="0,0,0,14"/><TextBlock Text="TCP/IP 레지스트리 및 MSMQ 설정" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
     <Button x:Name="ApplyFastPingButton" Content="패스트핑 원클릭 적용하기" Click="ApplyFastPing_Click" Background="#314BA6" Margin="0,0,0,8"/>
     <Button x:Name="RevertFastPingButton" Content="적용 해제하기" Click="RevertFastPing_Click"/>
     <TextBlock Text="관리자 권한이 필요하며, 변경 후 재부팅하세요.&#x0a;해제는 기존 최적화 설정값을 삭제하는 방식입니다." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
     <TextBlock x:Name="FastPingAppliedText" Text="상태 확인 중…" Foreground="#B9C9FF" TextWrapping="Wrap" Margin="0,16,0,0"/>
     <TextBlock x:Name="FastPingStatusText" Text="실행 대기" Foreground="#B9C9FF" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border x:Name="AuctionPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="AuctionModeBox" Style="{StaticResource AuctionSearchMode}" SelectedIndex="0" Padding="10,7" Margin="0,0,6,0"><ComboBoxItem Content="매물 이름 검색"/><ComboBoxItem Content="키워드 검색"/></ComboBox><Button Grid.Column="1" x:Name="AuctionSearchButton" Content="검색" Click="AuctionSearch_Click" Padding="8,5"/></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AuctionQueryBox" Padding="6,5" ToolTip="한 글자부터 아이템 이름 추천 · 키워드는 공백 또는 쉼표로 구분" KeyDown="AuctionQuery_KeyDown" TextChanged="AuctionQuery_TextChanged"/></Grid>
    <Popup x:Name="AuctionSuggestionsPopup" Grid.Row="1" PlacementTarget="{Binding ElementName=AuctionQueryBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
     <Border Background="{StaticResource NavyGradient}" CornerRadius="12" Padding="6" Width="{Binding ActualWidth, ElementName=AuctionQueryBox}" Opacity="{Binding Opacity, ElementName=FeaturePanel}"><StackPanel>
      <ListBox x:Name="AuctionSuggestionsList" MaxHeight="180" FontSize="11" PreviewMouseLeftButtonUp="AuctionSuggestion_Click" KeyDown="AuctionSuggestions_KeyDown"/>
      <TextBlock x:Name="AuctionSuggestionHint" Foreground="{StaticResource Muted}" FontSize="10" Margin="4,5,4,2" Text="이름을 선택하면 매물을 검색합니다."/>
     </StackPanel></Border>
    </Popup>
    <DataGrid Grid.Row="2" x:Name="AuctionResultsGrid" FontSize="11" RowHeight="32" ColumnHeaderHeight="28" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AuctionResults_SelectionChanged">
     <DataGrid.Resources><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,4"/></Style><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="6,4"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridTextColumn Header="아이템" Binding="{Binding Title}" Width="*" MinWidth="95"/><DataGridTextColumn Header="개당 골드" Binding="{Binding Price, StringFormat=N0}" Width="SizeToCells" MinWidth="78"/><DataGridTextColumn Header="수량" Binding="{Binding Count, StringFormat=N0}" Width="Auto" MinWidth="56"/><DataGridTextColumn Header="만료" Binding="{Binding ExpiryText}" Width="76"/></DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,8,0,8"><TextBlock x:Name="AuctionStatusText" Text="검색어를 입력하세요." FontSize="10" VerticalAlignment="Center"/><Button x:Name="AuctionMoreButton" Content="다음 매물" HorizontalAlignment="Right" IsEnabled="False" Click="AuctionMore_Click" Padding="8,4"/></Grid>
    <TextBox Grid.Row="4" x:Name="AuctionDetailsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="10" Text="매물을 선택하면 상세 옵션이 표시됩니다."/>
    <TextBlock Grid.Row="5" Text="Data based on NEXON Open API · 평균 약 10분 지연" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
   </Grid></Border>
   <Border x:Name="BeadPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed"/>
   <Border x:Name="FeePanel" Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed"/>
   <Border x:Name="GatheringHost" Grid.Row="1" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed"/>
   <Border x:Name="SettingsPanel" Grid.Row="1" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="설정" FontSize="17" Margin="0,0,0,12"/>
    <Button Content="백그라운드로 전환하기" Click="Background_Click" Padding="10,8" Margin="0,0,0,12"/>
    <CheckBox x:Name="StartupCheck" Style="{StaticResource GatherAlarmToggle}" Content="컴퓨터 시작 시 자동 실행" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,6"/>
    <CheckBox x:Name="StartBackgroundCheck" Style="{StaticResource GatherAlarmToggle}" Content="시작할 때 백그라운드로 실행" Checked="Preferences_Changed" Unchecked="Preferences_Changed" Margin="0,6"/>
    <CheckBox x:Name="CloseToTrayCheck" Style="{StaticResource GatherAlarmToggle}" Content="닫기 버튼을 누르면 트레이로 전환" Checked="Preferences_Changed" Unchecked="Preferences_Changed" Margin="0,6"/>
    <CheckBox x:Name="AlwaysTopCheck" Style="{StaticResource GatherAlarmToggle}" Content="다른 창 위에 항상 표시" Checked="Preferences_Changed" Unchecked="Preferences_Changed" Margin="0,6,0,12"/>
    <TextBlock x:Name="SettingsStatusText" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   </StackPanel></Border>
   <Border x:Name="UpdatePanel" Grid.Row="1" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed"><StackPanel>
    <TextBlock Text="프로그램 업데이트" FontSize="17" Margin="0,0,0,12"/>
    <TextBlock x:Name="CurrentVersionText" Text="현재 버전  BETA 0.1" Foreground="#B9C9FF" Margin="0,0,0,16"/>
    <Button x:Name="CheckUpdateButton" Content="최신버전 확인" Click="CheckUpdate_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,4,0,0"/>
    <TextBlock x:Name="UpdateStatusText" Text="최신버전을 확인해 주세요." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
   </StackPanel></Border>
   <Grid x:Name="BuffPanel" Grid.Row="1" Margin="0"><Grid x:Name="BuffMenu" Opacity="0.22" IsEnabled="False" IsHitTestVisible="False"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Padding="12"><StackPanel>
    <Grid Margin="0,0,0,10"><TextBlock Text="감지 컨트롤" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="중지됨" Foreground="#B9C9FF" HorizontalAlignment="Right" FontSize="11"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="영역 선택" Padding="10,8" Click="SelectRegion_Click" Margin="0,0,6,0"/><Button Grid.Column="1" x:Name="StartButton" Content="감지 시작" Background="#314BA6" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,8" Click="Start_Click" Margin="0,0,6,0"/><Button Grid.Column="2" x:Name="StopButton" Content="중지" Padding="14,8" Click="Stop_Click" IsEnabled="False"/></Grid>
    <TextBlock x:Name="RegionText" Text="감지 영역: 미지정" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel></Border>
   <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="버프 규칙" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <DataGrid Grid.Row="1" x:Name="RulesGrid" RowHeight="32" ColumnHeaderHeight="28" FontSize="11" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="버프명" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="감지" Binding="{Binding ThresholdDescription}" Width="*"/><DataGridTextColumn Header="알림 음성" Binding="{Binding AudioFileShort}" Width="1.2*"/></DataGrid.Columns></DataGrid>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="BuffNameBox" IsEditable="True" Padding="6,4" Margin="0,0,6,6"/>
     <Button Grid.Column="1" Content="음성 선택" Padding="10,5" Click="ChooseAudio_Click" Margin="0,0,0,6"/>
     <TextBox Grid.Row="1" x:Name="AudioPathBox" IsReadOnly="True" Padding="6,5" FontSize="10" Margin="0,0,6,0" ToolTip="선택한 알림 음성"/>
     <Button Grid.Row="1" Grid.Column="1" Content="규칙 저장" Padding="10,5" Click="AddRule_Click"/>

    </Grid>
   </Grid></Border>
  </Grid>
   <TextBlock x:Name="BuffPolicyNotice" Text="넥슨정책상 해당 기능이 지원되지 않습니다." Foreground="White" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False"/>
   </Grid>
   <StackPanel Grid.Row="2">
    <Border Background="{StaticResource NavyGradient}" CornerRadius="12" Padding="12,4" Margin="0,6,0,0"><Grid x:Name="TransparencyFooter"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="창 투명도" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
     <Slider Grid.Column="1" x:Name="WindowTransparencySlider" Style="{StaticResource SimpleSlider}" Minimum="0" Maximum="80" Value="0" Margin="10,0" VerticalAlignment="Center" ValueChanged="WindowTransparency_ValueChanged" ToolTip="0%는 불투명 · 상단바는 그대로 유지"/>
     <TextBlock Grid.Column="2" x:Name="WindowTransparencyText" Text="0%" FontSize="11" VerticalAlignment="Center" Width="32" TextAlignment="Right"/>
    </Grid></Border>
    <Button x:Name="ScheduleSiteButton" Content="블랙카드 일정 사이트" Click="ScheduleSite_Click" Padding="10,7" Margin="0,6,0,0"/>
   </StackPanel>
  </Grid>
  <Border x:Name="GatheringToast" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="12,0,12,84" Panel.ZIndex="40" Background="{StaticResource NavyGradient}" CornerRadius="12" Padding="12,9" IsHitTestVisible="False" Opacity="{Binding Opacity, ElementName=FeaturePanel}"><TextBlock x:Name="GatheringToastText" Foreground="#B8F0BF" TextWrapping="Wrap" FontSize="12"/></Border>
  <Canvas x:Name="ClickEffectsCanvas" Grid.RowSpan="3" Panel.ZIndex="50" IsHitTestVisible="False" ClipToBounds="True"/>
  <Popup x:Name="MusicPopup" PlacementTarget="{Binding ElementName=MusicTabButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
   <Border Background="{StaticResource NavyGradient}" BorderBrush="{StaticResource OutlineGradient}" BorderThickness="0" CornerRadius="14" Padding="14" Width="290" TextElement.Foreground="#EDF0F8" Opacity="{Binding Opacity, ElementName=FeaturePanel}"><StackPanel>
    <TextBlock Text="음악" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox x:Name="MusicList" DisplayMemberPath="DisplayName" MaxHeight="120" SelectionChanged="MusicList_SelectionChanged"/>
    <Button Content="+ 음악 추가" Padding="8,6" Margin="0,8,0,12" Click="AddMusic_Click"/>
    <Grid><TextBlock Text="배경음악 볼륨" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VolumeValueText" Text="10%" HorizontalAlignment="Right"/></Grid>
    <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100" Value="10" Margin="0,7,0,0" ValueChanged="MusicVolumeSlider_ValueChanged"/>
    <Grid Margin="0,16,0,0"><TextBlock Text="버프 알림 볼륨" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AlertVolumeValueText" Text="100%" HorizontalAlignment="Right"/></Grid>
    <Slider x:Name="AlertVolumeSlider" Minimum="0" Maximum="100" Value="100" Margin="0,7,0,0" ValueChanged="AlertVolumeSlider_ValueChanged"/>
   </StackPanel></Border>
  </Popup>
 </Grid></Border>
</Window>















