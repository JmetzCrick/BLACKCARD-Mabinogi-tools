<Window x:Class="BuffAssistant.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" WindowState="Maximized" Topmost="True"
        AllowsTransparency="True" Background="#33000000" Cursor="Cross"
        ShowInTaskbar="False">
    <Canvas x:Name="RootCanvas" Background="Transparent"
            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
            MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp">
        <TextBlock Canvas.Left="24" Canvas.Top="24" Foreground="White" FontSize="20"
                   Text="버프명과 오른쪽 남은 시간을 함께 드래그하세요 · ESC 취소"/>
        <Rectangle x:Name="SelectionRect" Stroke="#FFB44A" StrokeThickness="2"
                   Fill="#33FFB44A" Visibility="Collapsed"/>
    </Canvas>
</Window>
